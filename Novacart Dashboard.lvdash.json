      ],
      "catalog": "novacart_adb",
      "schema": "gold"
    },
    {
      "name": "total_orders_scalar",
      "displayName": "Total Orders Scalar",
      "queryLines": [
        "SELECT\n",
        "  COUNT(order_id) AS total_orders,\n",
        "  'all' AS period\n",
        "FROM\n",
        "  novacart_adb.gold.orders_information"
      ]
    },
    {
      "name": "total_products_scalar",
      "displayName": "Total Paid Amount Scalar",
      "queryLines": [
        "SELECT\n",
        "  SUM(paid_amount) AS total_paid_amount,\n",
        "  'all' AS period\n",
        "FROM\n",
        "  novacart_adb.gold.orders_information"
      ]
    },
    {
      "name": "gmv_scalar",
      "displayName": "GMV Scalar",
      "queryLines": [
        "SELECT\n",
        "  SUM(order_amount) AS gross_merchandise_value,\n",
        "  'all' AS period\n",
        "FROM\n",
        "  novacart_adb.gold.orders_information\n",
        "WHERE\n",
        "  order_amount > 0"
      ]
    }
  ],
